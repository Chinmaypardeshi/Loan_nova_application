# ==============================================================================
# LoanNova Backend — Environment Variables
# Copy this file to .env and fill in your Supabase credentials
# ==============================================================================

# ── DATABASE (Supabase PostgreSQL) ──────────────────────────────────────────
# Get this from: Supabase Dashboard → Project Settings → Database → Connection String
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# ── SERVER ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── AUTH ─────────────────────────────────────────────────────────────────────
# Use a long random string (e.g. openssl rand -base64 64)
JWT_SECRET=change_this_to_a_long_random_secret_key_min_32_chars
JWT_EXPIRES_IN=7d

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (your web app domain + localhost)
# Example: https://your-web-app.vercel.app,http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
